# VELA_RELAY_EXECUTOR_ATTEMPT_TTL_SECS=172800
# TELEGRAM_BOT_TOKEN=            # pairs with TELEGRAM_CHAT_ID (both or neither)
# TELEGRAM_CHAT_ID=
